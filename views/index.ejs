<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Task Manager App</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Task Manager App</h1>

    <% if(currentUser){ %>

        <h3>
            Welcome,
            <%= currentUser.username %>
        </h3>

    <% } %>

    <!-- SEARCH FORM -->

    <form action="/tasks" method="GET">

        <input type="text"
               name="search"
               placeholder="Search tasks...">

        <button type="submit">
            Search
        </button>

    </form>

    <br>

    <!-- NAVIGATION -->

    <a href="/tasks">
        All Tasks
    </a>

    |

    <a href="/tasks?status=completed">
        Completed
    </a>

    |

    <a href="/tasks?status=pending">
        Pending
    </a>

    |

    <a href="/tasks/new">
        Create Task
    </a>

    |

    <a href="/logout">
        Logout
    </a>

    <hr>

    <!-- TASK LIST -->

    <% if(tasks.length === 0){ %>

        <h3>No Tasks Found</h3>

    <% } %>

    <% for(let task of tasks){ %>

        <div class="task">

            <h2>
                <%= task.title %>
            </h2>

            <p>
                <strong>Description:</strong>

                <%= task.description %>
            </p>

            <p>
                <strong>Priority:</strong>

                <%= task.priority %>
            </p>

            <p>
                <strong>Due Date:</strong>

                <%= task.dueDate
                    ? task.dueDate.toDateString()
                    : "No Date" %>
            </p>

            <p>
                <strong>Status:</strong>

                <%= task.completed
                    ? "Completed"
                    : "Pending" %>
            </p>

            <!-- TOGGLE STATUS -->

            <form action="/tasks/<%= task._id %>/toggle?_method=PUT"
                  method="POST">

                <button type="submit">

                    <%= task.completed
                        ? "Mark Pending"
                        : "Mark Completed" %>

                </button>

            </form>

            <br>

            <!-- EDIT -->

            <form action="/tasks/<%= task._id %>/edit"
                  method="GET">

                <button type="submit">
                    Edit
                </button>

            </form>

            <br>

            <!-- DELETE -->

            <form action="/tasks/<%= task._id %>?_method=DELETE"
                  method="POST"
                  class="delete-form">

                <button type="submit">
                    Delete
                </button>

            </form>

            <br>

            <!-- VIEW DETAILS -->

            <a href="/tasks/<%= task._id %>">
                View Details
            </a>

        </div>

        <hr>

    <% } %>

    <script src="/app.js"></script>

</body>
</html>